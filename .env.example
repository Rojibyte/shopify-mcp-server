# Your dev store subdomain, without .myshopify.com (e.g. rojibyte-mcp-demo)
SHOPIFY_SHOP=
# From Dev Dashboard → your app → Settings
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Admin API version to pin (latest stable shown in the Dev Dashboard)
SHOPIFY_API_VERSION=2026-10
# Products at or below this quantity are flagged as low stock
LOW_STOCK_THRESHOLD=5
